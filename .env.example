# Microsoft Graph Explorer Configuration
# Copy this file to .env and fill in your values

# Azure AD Application Registration
# Create an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
REACT_APP_CLIENT_ID=your-client-id-here

# Application Insights (optional, for telemetry)
REACT_APP_INSTRUMENTATION_KEY=your-instrumentation-key-here

# God Mode Configuration (for bulk provisioning)
# These are used by the extended PowerShell/CLI tools
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# GitHub Enterprise Integration (optional)
GHE_INSTANCE_URL=https://your-ghe-instance.com
GHE_ADMIN_TOKEN=your-ghe-pat

# Proxy Configuration (optional)
# REACT_APP_PROXY_URL=https://your-proxy-url
